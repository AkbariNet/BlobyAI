<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:Sent="clr-namespace:BlobyAI.ChatElement"
             x:Class="BlobyAI.ChatElement.Sent"
        BackgroundColor="{AppThemeBinding Light={DynamicResource Gray100}, Dark={DynamicResource Gray900}}" 
        
        StrokeThickness="1"
              x:Name="SentMessage"
             HorizontalOptions="End"
             Margin="30,10,10,10"
             StrokeShape="20" 
        xmlns:FlowDirection="clr-namespace:BlobyAI.Properties"
        FlowDirection="{x:Static FlowDirection:MainLanguage.FlowDirection}">
    <Border.BindingContext>
        <Sent:MessagesVM></Sent:MessagesVM>
    </Border.BindingContext>

    <Label  Margin="15" Text="{Binding ContextOfText , Mode=TwoWay}" TextColor="{AppThemeBinding Light={DynamicResource Gray900}, Dark={DynamicResource Gray100}}"></Label>
        
  
</Border>